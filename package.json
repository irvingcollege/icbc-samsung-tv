{
  "name": "icbc-samsung-tv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check js/catalog.js && node --check js/platform.js && node --check js/app.js && node --check scripts/serve.js && node --check scripts/build.js && node scripts/validate.js && node --check scripts/package.js && node --check scripts/package-unsigned.js",
    "build": "node scripts/build.js",
    "package:tizen": "node scripts/package.js",
    "package:unsigned": "node scripts/package-unsigned.js",
    "setup:tizen": "python3 scripts/setup-tizen-linux.py",
    "check:sdk": "python3 scripts/validate-tizen-sdk.py",
    "setup:samsung-tv": "python3 scripts/setup-samsung-tv.py",
    "check:samsung-tv": "python3 scripts/validate-samsung-tv.py",
    "test:samsung-tv": "python3 -m unittest discover -s tests -p test_samsung_tv.py"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "acorn": "8.15.0",
    "adm-zip": "0.6.1",
    "hls.js": "1.6.13",
    "playwright": "1.61.1"
  }
}
